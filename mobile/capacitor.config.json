{
  "appId": "com.cascadeguard.app",
  "appName": "Cascade Guard",
  "webDir": "www",
  "backgroundColor": "#f2f5f1",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "CascadeGuardApp/1.0 (Android)",
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "appendUserAgent": "CascadeGuardApp/1.0 (iOS)",
    "contentInset": "always"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    }
  }
}
