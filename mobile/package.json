{
  "name": "cascade-guard-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Cascade Guard for Android and iPhone: the dashboard (conversations, leads, documents, test chat) as a phone app.",
  "license": "MIT",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "assets": "capacitor-assets generate --iconBackgroundColor '#23527c' --iconBackgroundColorDark '#23527c' --splashBackgroundColor '#f2f5f1' --splashBackgroundColorDark '#161c1f'",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
