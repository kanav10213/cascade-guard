# Cascade Guard settings. `cascade-guard init` copies this file to .env; fill in ONE provider.
# .env is read when the server starts; restart after changing it. Never commit .env.

# ---- Option A: Anthropic (default) ------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# ---- Option B: any OpenAI-compatible API ------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_MODEL=                 # the model name your provider uses
# OPENAI_BASE_URL=https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:      http://localhost:11434/v1   (free, local, no key needed)

# ---- Option C: a free model (Groq; no card needed, sign up at console.groq.com) --
# LLM_PROVIDER=auto              # auto: uses whichever key is set, the simulator when none is
# OPENAI_API_KEY=                # your Groq key (starts with gsk_)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b  # the default on Groq
# LLM_REASONING_EFFORT=low       # shorter thinking: faster, and stays inside the free limits
# LLM_PRICE_IN=0
# LLM_PRICE_OUT=0
# ASSISTANT_MODEL_ROLE=viewer    # who may use the model on /assistant (default admin)

# ---- Option D: try the app with no key (made-up answers, no cost) ----------
# LLM_PROVIDER=fake

# ---- Price, for cost tracking (USD per million tokens) ---------------------
# Known for claude-haiku-5-5. For other models set both, or cost shows as unknown.
# LLM_PRICE_IN=
# LLM_PRICE_OUT=

# ---- Safety limits for the web server (reset on restart) -------------------
LLM_MAX_COST=1.00
LLM_MAX_CALLS=1000

# ---- Access control (send the key as the X-API-Key header) -------------------
# With no keys set, only this computer can use the server. Set at least API_KEY before others can reach it.
# API_KEY=long-random-string-for-admins        # everything, including model calls that cost money
# REVIEWER_KEY=another-long-random-string      # read + free demos + approve/reject items in the review queue
# VIEWER_KEY=a-third-long-random-string        # read + free demos only

# ---- Claude on the web (claude.ai custom connector) ---------------------------
# MCP_CONNECTOR_TOKEN=a-long-random-string-of-24-or-more   # turns on https://<server>/mcp/<this value>
# MCP_CONNECTOR_ROLE=viewer       # viewer (free tools) | reviewer (+ review queue) | admin (+ paid tools)

# ---- Operations ----------------------------------------------------------------
# RATE_LIMIT_PER_MIN=120          # requests per minute per key (or per address without a key)
# LLM_RATE_LIMIT_PER_MIN=20       # per minute on routes that call the model
# AUDIT=on                        # log every POST and every refused request (who, what, when)

# ---- Storage (SQLite) --------------------------------------------------------
# CASCADE_DB=data/cascade.db      # SQLite file (default); "off" disables storage
# CASCADE_DB=postgresql://user:password@localhost:5432/cascade   # PostgreSQL instead
#   (then: pip install "cascade-guard-ai[postgres]")
# RETENTION_DAYS=30               # delete saved runs older than this at start-up
